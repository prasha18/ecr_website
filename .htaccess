RewriteEngine on
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}\.php -f
RewriteRule ^(.*)$ $1.php [NC,L]

RewriteRule ^([a-zA-Z-0-9-_]+)$ profile.php?p=$1 [L]
RewriteRule ^([a-zA-Z-0-9-_]+)/([a-zA-Z]+)$ profile.php?name=$1 [QSA,L]
RewriteRule ^([a-zA-Z-0-9-_]+)/([0-9]+)$ profile.php?name=$1 [QSA,L]

RewriteEngine On

RewriteRule ^blog/([a-zA-Z0-9-_]+)$ blog_view.php?p=$1 [QSA,L]

RewriteRule ^blog/([a-zA-Z0-9-_]+)/([a-zA-Z]+)$ blog_view.php?url=$1 [QSA,L]

RewriteRule ^blog/([a-zA-Z0-9-_]+)/([0-9]+)$ blog_view.php?url=$1 [QSA,L]



# php -- BEGIN cPanel-generated handler, do not edit
# Set the “ea-php81” package as the default “PHP” programming language.
<IfModule mime_module>
  AddHandler application/x-httpd-ea-php81 .php .php8 .phtml
</IfModule>
# php -- END cPanel-generated handler, do not edit

